# Скопируйте в .env и заполните. Файл .env в git не попадает.
BASE_URL=https://labcompass.ru
DB_PATH=/var/lib/labcompass/app.db
# Почта для кодов входа и напоминаний (timeweb). Пустой SMTP_HOST — коды пишутся в лог (для проверки).
SMTP_HOST=smtp.timeweb.ru
SMTP_PORT=465
SMTP_USER=info@labcompass.ru
SMTP_PASSWORD=
MAIL_FROM=ЛабКомпас <info@labcompass.ru>
# Кто получает права администратора при входе (через запятую)
ADMIN_EMAILS=info@labcompass.ru
# Сколько единиц оборудования бесплатно, без подписки
FREE_LIMIT=10
# 0 — только для проверки на своём компьютере по http
COOKIE_SECURE=1
# Кто оператор персональных данных (для страницы политики): ФИО и статус, например «Иванов И. И., самозанятый, ИНН ...»
OPERATOR=
